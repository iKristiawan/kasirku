rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // COMMON HARDENING PRIMITIVES
    // =========================================================================
    function isValidDocId(docId) {
      return docId is string &&
             docId.size() >= 1 &&
             docId.size() <= 128 &&
             docId.matches('^[a-zA-Z0-9_.-]+$');
    }

    function nonEmptyStr(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function optStr(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function nonNegNum(val, maxVal) {
      return val is number && val >= 0 && val <= maxVal;
    }

    function optNonNegNum(val, maxVal) {
      return val == null || (val is number && val >= 0 && val <= maxVal);
    }

    function optBoundedNum(val, minVal, maxVal) {
      return val == null || (val is number && val >= minVal && val <= maxVal);
    }

    function optBool(val) {
      return val == null || val is bool;
    }

    function optList(val, maxItems) {
      return val == null || (val is list && val.size() <= maxItems);
    }

    function optMap(val, maxKeys) {
      return val == null || (val is map && val.keys().size() <= maxKeys);
    }

    // =========================================================================
    // DOMAIN ENTITY VALIDATORS (Strict Schema, Bounds & Enum Enforcement)
    // =========================================================================
    function isValidUser(data) {
      return data.keys().size() <= 12 &&
             nonEmptyStr(data.get('name', ''), 120) &&
             data.get('pin', '') is string &&
             data.get('pin', '').matches('^[0-9]{4,8}$') &&
             data.get('role', '') in ['ADMIN', 'STORE_MANAGER', 'KARYAWAN'] &&
             optStr(data.get('avatarColor', null), 80);
    }

    function isValidCategory(data) {
      return data.keys().size() <= 12 &&
             nonEmptyStr(data.get('name', ''), 100) &&
             nonEmptyStr(data.get('color', ''), 32) &&
             optStr(data.get('description', null), 300) &&
             optStr(data.get('icon', null), 60);
    }

    function isValidProduct(data) {
      return data.keys().size() <= 40 &&
             nonEmptyStr(data.get('name', ''), 180) &&
             nonEmptyStr(data.get('category', ''), 100) &&
             nonEmptyStr(data.get('baseUnit', ''), 40) &&
             optStr(data.get('barcode', null), 80) &&
             optStr(data.get('sku', null), 80) &&
             nonNegNum(data.get('stockInBaseUnit', -1), 10000000) &&
             optNonNegNum(data.get('minStockAlert', null), 10000000) &&
             optNonNegNum(data.get('costPrice', null), 1000000000) &&
             (data.get('productType', null) == null || data.get('productType', null) in ['BARANG', 'JASA']) &&
             optStr(data.get('imageUrl', null), 500000) &&
             optStr(data.get('expiryDate', null), 32) &&
             optStr(data.get('supplierId', null), 128) &&
             optList(data.get('units', null), 20) &&
             optList(data.get('batches', null), 250) &&
             optList(data.get('variantOptions', null), 50) &&
             optMap(data.get('customerCategoryPrices', null), 40);
    }

    function isValidCustomer(data) {
      return data.keys().size() <= 26 &&
             nonEmptyStr(data.get('name', ''), 140) &&
             optStr(data.get('phone', null), 40) &&
             optStr(data.get('whatsapp', null), 40) &&
             optStr(data.get('email', null), 160) &&
             optStr(data.get('address', null), 400) &&
             nonNegNum(data.get('totalPoints', -1), 100000000) &&
             optNonNegNum(data.get('creditLimit', null), 10000000000) &&
             nonNegNum(data.get('totalDebt', -1), 10000000000) &&
             optStr(data.get('customerCategory', null), 60) &&
             optStr(data.get('membershipTier', null), 40) &&
             optStr(data.get('membershipId', null), 64) &&
             optBool(data.get('isMember', null)) &&
             optStr(data.get('notes', null), 1000);
    }

    function isValidCustomerCategory(data) {
      return data.keys().size() <= 12 &&
             nonEmptyStr(data.get('name', ''), 80) &&
             nonEmptyStr(data.get('color', ''), 40) &&
             optStr(data.get('description', null), 300) &&
             optBool(data.get('isSystemDefault', null));
    }

    function isValidTransaction(data) {
      return data.keys().size() <= 54 &&
             nonEmptyStr(data.get('invoiceNumber', ''), 64) &&
             data.get('timestamp', 0) is number &&
             data.get('timestamp', 0) > 0 &&
             nonEmptyStr(data.get('cashierId', ''), 128) &&
             nonEmptyStr(data.get('cashierName', ''), 120) &&
             optStr(data.get('customerEmail', null), 160) &&
             optStr(data.get('receiptEmailSentTo', null), 160) &&
             optNonNegNum(data.get('receiptEmailSentAt', null), 10000000000000) &&
             nonNegNum(data.get('subtotal', 0), 10000000000) &&
             optNonNegNum(data.get('discount', null), 10000000000) &&
             optNonNegNum(data.get('pointsUsed', null), 100000000) &&
             optNonNegNum(data.get('pointsDiscountAmount', null), 10000000000) &&
             optNonNegNum(data.get('pointsEarned', null), 100000000) &&
             nonNegNum(data.get('finalAmount', -1), 10000000000) &&
             nonEmptyStr(data.get('paymentMethod', ''), 120) &&
             data.get('paymentStatus', '') in ['LUNAS', 'BELUM_LUNAS'] &&
             optStr(data.get('dueDate', null), 32) &&
             optStr(data.get('notes', null), 2000) &&
             optStr(data.get('qrCodeDataUrl', null), 200000) &&
             optBoundedNum(data.get('customerRating', null), 1, 5) &&
             optStr(data.get('customerRatingComment', null), 1000) &&
             optList(data.get('customerRatingTags', null), 20) &&
             optList(data.get('auditLogs', null), 100) &&
             optList(data.get('returns', null), 50) &&
             optNonNegNum(data.get('returnedAmount', null), 10000000000) &&
             optNonNegNum(data.get('returnedPoints', null), 100000000) &&
             (data.get('returnStatus', null) == null || data.get('returnStatus', null) in ['NONE', 'PARTIAL', 'FULL']) &&
             data.get('items', null) is list &&
             data.get('items', []).size() > 0 &&
             data.get('items', []).size() <= 250;
    }

    function isValidSupplier(data) {
      return data.keys().size() <= 16 &&
             nonEmptyStr(data.get('name', ''), 160) &&
             optStr(data.get('contactPerson', null), 120) &&
             optStr(data.get('phone', null), 40) &&
             optStr(data.get('whatsapp', null), 40) &&
             optStr(data.get('address', null), 400) &&
             optList(data.get('suppliedCategories', null), 50);
    }

    function isValidAttendance(data) {
      return data.keys().size() <= 18 &&
             nonEmptyStr(data.get('userId', ''), 128) &&
             nonEmptyStr(data.get('userName', ''), 120) &&
             data.get('userRole', '') in ['ADMIN', 'STORE_MANAGER', 'KARYAWAN'] &&
             nonEmptyStr(data.get('date', ''), 20) &&
             nonEmptyStr(data.get('checkInTime', ''), 20) &&
             data.get('checkInTimestamp', 0) is number &&
             data.get('checkInTimestamp', 0) > 0 &&
             optNonNegNum(data.get('durationMinutes', null), 10000) &&
             optStr(data.get('notes', null), 500) &&
             data.get('status', '') in ['PRESENT', 'COMPLETED'];
    }

    function isValidStockOpname(data) {
      return data.keys().size() <= 20 &&
             nonEmptyStr(data.get('sessionNumber', ''), 64) &&
             nonEmptyStr(data.get('date', ''), 20) &&
             data.get('timestamp', 0) is number &&
             data.get('timestamp', 0) > 0 &&
             nonEmptyStr(data.get('auditorName', ''), 120) &&
             optNonNegNum(data.get('totalItemsAudited', null), 100000) &&
             optNonNegNum(data.get('totalDiscrepancies', null), 100000) &&
             data.get('items', null) is list &&
             data.get('items', []).size() > 0 &&
             data.get('items', []).size() <= 500 &&
             optStr(data.get('generalReason', null), 200) &&
             optStr(data.get('notes', null), 1000);
    }

    function isValidPurchase(data) {
      return data.keys().size() <= 28 &&
             nonEmptyStr(data.get('poNumber', ''), 64) &&
             optStr(data.get('supplierId', null), 128) &&
             nonEmptyStr(data.get('supplierName', ''), 160) &&
             nonEmptyStr(data.get('date', ''), 20) &&
             data.get('status', '') in ['DRAFT', 'SELESAI'] &&
             nonNegNum(data.get('totalAmount', -1), 10000000000) &&
             data.get('items', null) is list &&
             data.get('items', []).size() > 0 &&
             data.get('items', []).size() <= 250 &&
             optStr(data.get('notes', null), 1000);
    }

    function isValidCashflow(data) {
      return data.keys().size() <= 22 &&
             data.get('type', '') in ['PENGELUARAN', 'PEMASUKAN'] &&
             nonEmptyStr(data.get('category', ''), 100) &&
             nonNegNum(data.get('amount', -1), 10000000000) &&
             nonEmptyStr(data.get('date', ''), 20) &&
             data.get('timestamp', 0) is number &&
             data.get('timestamp', 0) > 0 &&
             nonEmptyStr(data.get('paymentMethod', ''), 60) &&
             optStr(data.get('description', null), 1000) &&
             optStr(data.get('referenceNumber', null), 100) &&
             optStr(data.get('recordedBy', null), 120) &&
             optBool(data.get('isCashWithdrawalOutflow', null)) &&
             optBool(data.get('isCashWithdrawalAdminProfit', null)) &&
             optNonNegNum(data.get('withdrawalPrincipalAmount', null), 10000000000) &&
             optNonNegNum(data.get('withdrawalAdminFeeAmount', null), 10000000000);
    }

    function isValidStoreSettings(data) {
      return data.keys().size() <= 85 &&
             nonEmptyStr(data.get('storeName', ''), 160) &&
             optStr(data.get('storeAddress', null), 500) &&
             optStr(data.get('storePhone', null), 80) &&
             optStr(data.get('storeHeaderReceipt', null), 500) &&
             optStr(data.get('storeFooterReceipt', null), 1000) &&
             optStr(data.get('storeLogo', null), 600000) &&
             optStr(data.get('qrisImageUrl', null), 600000) &&
             optNonNegNum(data.get('dailySalesGoal', null), 1000000000000) &&
             optNonNegNum(data.get('weeklySalesGoal', null), 1000000000000) &&
             optNonNegNum(data.get('monthlySalesGoal', null), 1000000000000) &&
             optStr(data.get('adminWhatsAppNumber', null), 80) &&
             optBoundedNum(data.get('adminLowStockTriggerCount', null), 1, 100) &&
             optNonNegNum(data.get('spendPerPoint', null), 1000000000) &&
             optNonNegNum(data.get('pointsPerSpend', null), 100000) &&
             optNonNegNum(data.get('pointValueRupiah', null), 10000000) &&
             optList(data.get('customPaymentMethods', null), 25) &&
             optList(data.get('storeUnits', null), 50) &&
             optList(data.get('stockTransferRequests', null), 100) &&
             optMap(data.get('categorySalesGoals', null), 100) &&
             optMap(data.get('scheduledAdminLowStockWhatsApp', null), 15) &&
             optMap(data.get('scheduledDailySalesReportWhatsApp', null), 15) &&
             optMap(data.get('membershipDiscounts', null), 10) &&
             optMap(data.get('chartTheme', null), 10) &&
             optMap(data.get('taxConfig', null), 30);
    }

    function isValidOnlineOrder(data) {
      return data.keys().size() <= 32 &&
             nonEmptyStr(data.get('orderCode', ''), 40) &&
             nonEmptyStr(data.get('customerName', ''), 120) &&
             data.get('customerWhatsapp', '') is string &&
             data.get('customerWhatsapp', '').size() >= 6 &&
             data.get('customerWhatsapp', '').size() <= 30 &&
             data.get('fulfillmentType', '') in ['AMBIL_DI_TOKO', 'KIRIM_KURIR'] &&
             data.get('status', '') in ['MENUNGGU_KONFIRMASI', 'DIPROSES', 'SIAP_DIAMBIL', 'DIKIRIM', 'SELESAI', 'DIBATALKAN'] &&
             nonNegNum(data.get('totalAmount', -1), 10000000000) &&
             optNonNegNum(data.get('subtotal', null), 10000000000) &&
             optNonNegNum(data.get('deliveryFee', null), 100000000) &&
             optNonNegNum(data.get('discount', null), 10000000000) &&
             optStr(data.get('customerAddress', null), 500) &&
             optStr(data.get('customerNote', null), 500) &&
             data.get('items', null) is list &&
             data.get('items', []).size() > 0 &&
             data.get('items', []).size() <= 200;
    }

    // =========================================================================
    // ACTIVITY LOG VALIDATOR
    // =========================================================================
    function isValidActivityLog(data) {
      return data.keys().size() <= 18 &&
             data.get('timestamp', 0) is number &&
             data.get('timestamp', 0) > 0 &&
             data.get('actionType', '') in ['DELETE_TRANSACTION', 'MANUAL_PRICE_EDIT', 'MANUAL_STOCK_ADJUSTMENT', 'EDIT_TRANSACTION', 'ITEM_RETURN'] &&
             nonEmptyStr(data.get('actorId', ''), 128) &&
             nonEmptyStr(data.get('actorName', ''), 120) &&
             data.get('actorRole', '') in ['ADMIN', 'STORE_MANAGER', 'KARYAWAN'] &&
             data.get('targetType', '') in ['TRANSACTION', 'PRODUCT', 'CART_ITEM', 'STOCK_OPNAME'] &&
             nonEmptyStr(data.get('targetId', ''), 128) &&
             nonEmptyStr(data.get('targetLabel', ''), 240) &&
             nonEmptyStr(data.get('summary', ''), 600) &&
             optStr(data.get('oldValue', null), 300) &&
             optStr(data.get('newValue', null), 300) &&
             optStr(data.get('deltaValue', null), 200) &&
             optBoundedNum(data.get('numericDelta', null), -10000000000, 10000000000) &&
             optStr(data.get('reason', null), 500) &&
             optStr(data.get('invoiceNumber', null), 80) &&
             optStr(data.get('productId', null), 128) &&
             optMap(data.get('metadata', null), 20);
    }

    // =========================================================================
    // RECEIPT EMAIL QUEUE VALIDATOR (Firebase Trigger Email Extension Schema)
    // =========================================================================
    function isValidMail(data) {
      return data.keys().hasAll(['to', 'message']) &&
             data.keys().hasOnly(['id', 'to', 'message', 'metadata', 'createdAt']) &&
             !('delivery' in data) &&
             data.to is list &&
             data.to.size() >= 1 &&
             data.to.size() <= 5 &&
             data.to[0] is string &&
             data.to[0].size() >= 5 &&
             data.to[0].size() <= 160 &&
             data.to[0].matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
             data.message is map &&
             data.message.keys().hasAll(['subject', 'text']) &&
             data.message.keys().hasOnly(['subject', 'text', 'html']) &&
             nonEmptyStr(data.message.get('subject', ''), 200) &&
             nonEmptyStr(data.message.get('text', ''), 20000) &&
             optStr(data.message.get('html', null), 60000) &&
             optMap(data.get('metadata', null), 16) &&
             optNonNegNum(data.get('createdAt', null), 10000000000000);
    }

    // =========================================================================
    // TAX RECORDS VALIDATOR
    // =========================================================================
    function isValidTaxRecord(data) {
      return data.keys().size() <= 22 &&
             nonEmptyStr(data.get('periodMonth', ''), 10) &&
             data.get('taxType', '') in ['PPH_FINAL_UMKM', 'PPH_BADAN', 'PPN', 'PB1', 'PPH_21', 'LAINNYA'] &&
             nonEmptyStr(data.get('taxTypeLabel', ''), 120) &&
             nonNegNum(data.get('taxBaseAmount', -1), 100000000000) &&
             nonNegNum(data.get('taxRatePercent', -1), 100) &&
             nonNegNum(data.get('taxAmountDue', -1), 10000000000) &&
             nonNegNum(data.get('paidAmount', -1), 10000000000) &&
             data.get('status', '') in ['BELUM_SETOR', 'SUDAH_SETOR'] &&
             optStr(data.get('billingCode', null), 80) &&
             optStr(data.get('ntpnCode', null), 80) &&
             optStr(data.get('paidDate', null), 20) &&
             optStr(data.get('paymentMethod', null), 60) &&
             optStr(data.get('notes', null), 1000) &&
             optStr(data.get('linkedCashflowId', null), 128) &&
             nonEmptyStr(data.get('recordedBy', ''), 120) &&
             data.get('timestamp', 0) is number &&
             data.get('timestamp', 0) > 0 &&
             nonEmptyStr(data.get('createdAt', ''), 64) &&
             optStr(data.get('updatedAt', null), 64);
    }

    // =========================================================================
    // TAX AUDIT LOGS VALIDATOR (Immutable Audit Trail)
    // =========================================================================
    function isValidTaxAuditLog(data) {
      return data.keys().size() <= 16 &&
             data.get('timestamp', 0) is number &&
             data.get('timestamp', 0) > 0 &&
             nonEmptyStr(data.get('createdAt', ''), 64) &&
             data.get('category', '') in ['CONFIG_CHANGE', 'RATE_OVERRIDE', 'ADJUSTMENT', 'RECORD_MUTATION'] &&
             nonEmptyStr(data.get('actionLabel', ''), 180) &&
             nonEmptyStr(data.get('actorId', ''), 128) &&
             nonEmptyStr(data.get('actorName', ''), 120) &&
             data.get('actorRole', '') in ['ADMIN', 'STORE_MANAGER', 'KARYAWAN'] &&
             nonEmptyStr(data.get('summary', ''), 800) &&
             optList(data.get('changes', null), 50) &&
             optStr(data.get('reason', null), 600) &&
             optStr(data.get('periodMonth', null), 12);
    }

    // =========================================================================
    // TAX ADJUSTMENTS VALIDATOR
    // =========================================================================
    function isValidTaxAdjustment(data) {
      return data.keys().size() <= 18 &&
             nonEmptyStr(data.get('adjustmentNumber', ''), 64) &&
             nonEmptyStr(data.get('periodMonth', ''), 10) &&
             nonEmptyStr(data.get('adjustmentDate', ''), 20) &&
             data.get('reasonType', '') in ['PEMBATALAN_FAKTUR', 'KESALAHAN_INPUT', 'RETUR_NOTA_RETUR', 'KOREKSI_TARIF_DPP', 'LAINNYA'] &&
             data.get('affectedTaxType', '') in ['DPP_OMZET', 'PPH_FINAL_UMKM', 'PPN_KELUARAN', 'PPN_MASUKAN', 'PB1'] &&
             data.get('direction', '') in ['DECREASE', 'INCREASE'] &&
             optStr(data.get('referenceInvoiceNumber', null), 100) &&
             optBoundedNum(data.get('dppDelta', 0), -100000000000, 100000000000) &&
             optBoundedNum(data.get('taxDelta', 0), -100000000000, 100000000000) &&
             data.get('status', '') in ['ACTIVE', 'VOIDED'] &&
             optStr(data.get('notes', null), 1000) &&
             nonEmptyStr(data.get('createdBy', ''), 120) &&
             optStr(data.get('createdById', null), 128) &&
             data.get('timestamp', 0) is number &&
             data.get('timestamp', 0) > 0 &&
             nonEmptyStr(data.get('createdAt', ''), 64) &&
             optStr(data.get('updatedAt', null), 64);
    }

    // =========================================================================
    // BALANCE SHEET ENTRIES VALIDATOR (Aktiva & Pasiva Manual Accounts)
    // =========================================================================
    function isValidBalanceSheetEntry(data) {
      return data.keys().size() <= 20 &&
             nonEmptyStr(data.get('accountCode', ''), 24) &&
             nonEmptyStr(data.get('accountName', ''), 160) &&
             data.get('section', '') in ['AKTIVA_LANCAR', 'AKTIVA_TETAP', 'KEWAJIBAN_LANCAR', 'KEWAJIBAN_JANGKA_PANJANG', 'EKUITAS'] &&
             nonNegNum(data.get('amount', -1), 1000000000000) &&
             optBool(data.get('isContra', null)) &&
             nonEmptyStr(data.get('asOfDate', ''), 20) &&
             (data.get('depreciationMethod', null) == null || data.get('depreciationMethod', null) in ['NONE', 'STRAIGHT_LINE']) &&
             optNonNegNum(data.get('usefulLifeMonths', null), 1200) &&
             optNonNegNum(data.get('salvageValue', null), 1000000000000) &&
             optStr(data.get('notes', null), 600) &&
             nonEmptyStr(data.get('createdBy', ''), 120) &&
             optStr(data.get('createdById', null), 128) &&
             data.get('timestamp', 0) is number &&
             data.get('timestamp', 0) > 0 &&
             nonEmptyStr(data.get('createdAt', ''), 64) &&
             optStr(data.get('updatedAt', null), 64);
    }

    // =========================================================================
    // COLLECTION MATCH RULES
    // =========================================================================

    // Users (Kasir / Store Manager / Admin PIN profiles)
    match /users/{userId} {
      allow get: if isValidDocId(userId);
      allow list: if true;
      allow create, update: if isValidDocId(userId) && isValidUser(request.resource.data);
      allow delete: if isValidDocId(userId);
    }

    // Product Categories
    match /categories/{categoryId} {
      allow get: if isValidDocId(categoryId);
      allow list: if true;
      allow create, update: if isValidDocId(categoryId) && isValidCategory(request.resource.data);
      allow delete: if isValidDocId(categoryId);
    }

    // Products Inventory
    match /products/{productId} {
      allow get: if isValidDocId(productId);
      allow list: if true;
      allow create, update: if isValidDocId(productId) && isValidProduct(request.resource.data);
      allow delete: if isValidDocId(productId);
    }

    // Customers & Loyalty Balances
    match /customers/{customerId} {
      allow get: if isValidDocId(customerId);
      allow list: if true;
      allow create, update: if isValidDocId(customerId) && isValidCustomer(request.resource.data);
      allow delete: if isValidDocId(customerId);
    }

    // Customer Categories
    match /customer_categories/{catId} {
      allow get: if isValidDocId(catId);
      allow list: if true;
      allow create, update: if isValidDocId(catId) && isValidCustomerCategory(request.resource.data);
      allow delete: if isValidDocId(catId);
    }

    // Sales Transactions (Financial Audit Trail: invoiceNumber immutable on update)
    match /transactions/{transactionId} {
      allow get: if isValidDocId(transactionId);
      allow list: if true;
      allow create: if isValidDocId(transactionId) && isValidTransaction(request.resource.data);
      allow update: if isValidDocId(transactionId) &&
                       isValidTransaction(request.resource.data) &&
                       request.resource.data.invoiceNumber == resource.data.invoiceNumber;
      allow delete: if isValidDocId(transactionId);
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow get: if isValidDocId(supplierId);
      allow list: if true;
      allow create, update: if isValidDocId(supplierId) && isValidSupplier(request.resource.data);
      allow delete: if isValidDocId(supplierId);
    }

    // Employee Attendance Shifts
    match /attendances/{attendanceId} {
      allow get: if isValidDocId(attendanceId);
      allow list: if true;
      allow create, update: if isValidDocId(attendanceId) && isValidAttendance(request.resource.data);
      allow delete: if isValidDocId(attendanceId);
    }

    // Stock Opname Audit Sessions (sessionNumber & date immutable once created)
    match /stock_opnames/{opnameId} {
      allow get: if isValidDocId(opnameId);
      allow list: if true;
      allow create: if isValidDocId(opnameId) && isValidStockOpname(request.resource.data);
      allow update: if isValidDocId(opnameId) &&
                       isValidStockOpname(request.resource.data) &&
                       request.resource.data.sessionNumber == resource.data.sessionNumber;
      allow delete: if isValidDocId(opnameId);
    }

    // Restock Purchases / POs
    match /purchases/{purchaseId} {
      allow get: if isValidDocId(purchaseId);
      allow list: if true;
      allow create, update: if isValidDocId(purchaseId) && isValidPurchase(request.resource.data);
      allow delete: if isValidDocId(purchaseId);
    }

    // Cashflow Records (Expenses & Misc Income)
    match /cashflows/{cashflowId} {
      allow get: if isValidDocId(cashflowId);
      allow list: if true;
      allow create, update: if isValidDocId(cashflowId) && isValidCashflow(request.resource.data);
      allow delete: if isValidDocId(cashflowId);
    }

    // Store Configuration Singleton (only store_config writable, non-deletable)
    match /settings/{settingId} {
      allow get: if isValidDocId(settingId);
      allow list: if true;
      allow create, update: if settingId == 'store_config' && isValidStoreSettings(request.resource.data);
      allow delete: if false;
    }

    // Online Storefront Orders (Immutable orderCode & totalAmount once placed)
    match /online_orders/{orderId} {
      allow get: if isValidDocId(orderId);
      allow list: if true;
      allow create: if isValidDocId(orderId) &&
                       isValidOnlineOrder(request.resource.data) &&
                       request.resource.data.status == 'MENUNGGU_KONFIRMASI';
      allow update: if isValidDocId(orderId) &&
                       isValidOnlineOrder(request.resource.data) &&
                       request.resource.data.orderCode == resource.data.orderCode &&
                       request.resource.data.totalAmount == resource.data.totalAmount;
      allow delete: if isValidDocId(orderId);
    }

    // Employee Sensitive Actions Audit Trail (Immutable log entries)
    match /activity_logs/{logId} {
      allow get: if isValidDocId(logId);
      allow list: if true;
      allow create: if isValidDocId(logId) && isValidActivityLog(request.resource.data);
      allow update: if false;
      allow delete: if isValidDocId(logId);
    }

    // Digital Receipt Email Dispatch Queue (Immutable client queue for Firebase Trigger Email)
    match /mail/{mailId} {
      allow get: if isValidDocId(mailId);
      allow list: if true;
      allow create: if isValidDocId(mailId) && isValidMail(request.resource.data);
      allow update, delete: if false;
    }

    // Tax Filing & Payment Records
    match /tax_records/{taxRecordId} {
      allow get: if isValidDocId(taxRecordId);
      allow list: if true;
      allow create, update: if isValidDocId(taxRecordId) && isValidTaxRecord(request.resource.data);
      allow delete: if isValidDocId(taxRecordId);
    }

    // Tax Configuration & Rate Override Audit Logs (Immutable Entries)
    match /tax_audit_logs/{logId} {
      allow get: if isValidDocId(logId);
      allow list: if true;
      allow create: if isValidDocId(logId) && isValidTaxAuditLog(request.resource.data);
      allow update: if false;
      allow delete: if isValidDocId(logId);
    }

    // Tax Adjustments (Corrections & Cancelled Invoices)
    match /tax_adjustments/{adjustmentId} {
      allow get: if isValidDocId(adjustmentId);
      allow list: if true;
      allow create, update: if isValidDocId(adjustmentId) && isValidTaxAdjustment(request.resource.data);
      allow delete: if isValidDocId(adjustmentId);
    }

    // Custom Balance Sheet Accounts (Neraca Aktiva & Pasiva)
    match /balance_sheet_entries/{entryId} {
      allow get: if isValidDocId(entryId);
      allow list: if true;
      allow create, update: if isValidDocId(entryId) && isValidBalanceSheetEntry(request.resource.data);
      allow delete: if isValidDocId(entryId);
    }

    // Default Deny Catch-All for any unrecognized path or subcollection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
